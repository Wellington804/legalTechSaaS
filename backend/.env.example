# -----------------------------------------------------------------------------
# LEGALTECH SAAS ENTERPRISE - BACKEND ENVIRONMENT VARIABLES (.env)
# -----------------------------------------------------------------------------

# Nome do Projeto
PROJECT_NAME="LegalTech SaaS Enterprise"
API_V1_STR="/api/v1"
SECRET_KEY="enterprise_super_secret_key_legaltech_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CONEXÃO COM BANCO DE DADOS (SUPABASE POSTGRESQL)
# Substitua a URL abaixo pela sua Connection String do Supabase.
# ATENÇÃO: Adicione "+asyncpg" logo após "postgresql" para usar o driver assíncrono do Python.
# Exemplo Supabase Direct: postgresql+asyncpg://postgres:[SUA_SENHA]@db.[SEU_PROJECT_REF].supabase.co:5432/postgres
# Exemplo Supabase Pooler: postgresql+asyncpg://postgres.[SEU_PROJECT_REF]:[SUA_SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/legaltech_db

# REDIS CACHE
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
