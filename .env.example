# Copy to .env.production on the VPS. Never commit the populated file.
# Do not put SENTRY_AUTH_TOKEN here: it is a CI-only build secret.
# Private pilot: APP_DOMAIN is the full lexflow-pilot.<tailnet>.ts.net name.
APP_DOMAIN=
# Still required by the shared production preflight; Caddy does not use ACME in the Tailscale overlay.
ACME_EMAIL=
FRONTEND_URL=
RELEASE=
# Optional direct support contact (public HTTPS or mailto:). No client data in URL.
SUPPORT_URL=

# VPS and Cloudflare automation metadata. Keep private keys outside this file.
VPS_HOST=
VPS_SSH_USER=
VPS_SSH_PORT=22
VPS_DEPLOY_PATH=/opt/legaltech
VPS_SSH_PRIVATE_KEY_PATH=
TAILSCALE_LOOPBACK_PORT=8080
TAILSCALE_HTTPS_PORT=443
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Generate independent URL-safe random values. URL-encode passwords only when building URLs.
SECRET_KEY=
ACCOUNT_TOKEN_PEPPER=
MFA_ENCRYPTION_KEY=
PRIVILEGED_MFA_REQUIRED=true
POSTGRES_DB=legaltech_db
POSTGRES_ADMIN_USER=legaltech_admin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_USER=legaltech_app
POSTGRES_APP_PASSWORD=
# Construct these from the real, URL-encoded passwords; leave the template blank.
MIGRATION_DATABASE_URL=
DATABASE_URL=
REDIS_PASSWORD=
REDIS_URL=

# Sentry DSN is optional. Keep the Sentry auth token in CI only, never here.
BACKEND_SENTRY_DSN=
FRONTEND_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

ACCOUNT_EMAILS_ENABLED=false
DEFAULT_TRIAL_DAYS=14
# Optional exact-email allowlist for a closed pilot. JSON list; empty keeps public registration enabled.
PILOT_ALLOWED_REGISTRATION_EMAILS=[]
TRIAL_QUOTA_USERS=3
TRIAL_QUOTA_STORAGE_BYTES=1073741824
TRIAL_QUOTA_MESSAGES=100

# Private Cloudflare R2 bucket for legal documents. The token must be scoped to this bucket only.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
DATAJUD_ENABLED=false
DATAJUD_API_KEY=
# The lawyer never selects this. Choose one provider for automatic monitoring on the VPS.
JUDICIAL_MONITORING_PROVIDER=datajud
ESCAVADOR_ENABLED=false
ESCAVADOR_API_TOKEN=
# Generate a long random Bearer token and configure the same value on the Escavador callback.
ESCAVADOR_CALLBACK_TOKEN=
AI_ENABLED=false
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_GENERAL_MODEL=openai/gpt-5.6-luna
OPENROUTER_GENERAL_REASONING=low
OPENROUTER_DEEP_MODEL=openai/gpt-5.6-luna
OPENROUTER_DEEP_REASONING=max
OPENROUTER_LEGAL_MODEL=openai/gpt-5.6-luna-pro
OPENROUTER_VISUAL_API_KEY=
OPENROUTER_VISUAL_MODEL=google/gemini-3.8-flash
OPENROUTER_IMAGE_MODEL=google/gemini-3-pro-image
OPENROUTER_APP_NAME=LexFlow
# Gemini remains available for existing installations and optional image generation.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional raster logo generation. Enable only after provider/cost checks.
BRAND_IMAGE_AI_ENABLED=false
GEMINI_IMAGE_MODEL=
# Use 0 to disable only the application's daily AI quota.
AI_REQUESTS_PER_DAY=20

# Generate once using python -m app.cli.push_keys; never rotate on each deploy.
# Public key goes to the browser; private key stays only in backend/worker.
# Subject must be a real mailto: contact or public HTTPS URL for production.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# Keep dry-run enabled until staging provider checks pass.
NOTIFICATIONS_DRY_RUN=true
# Must remain false. Production communications are only case-bound internally.
UNBOUND_NOTIFICATION_DISPATCH_ENABLED=false
NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=900
NOTIFICATION_RECONCILE_BATCH_SIZE=100
NOTIFICATION_MAX_DELIVERY_ATTEMPTS=5
NOTIFICATION_RETRY_DELAY_SECONDS=60
# Ops health gate: allows two 60-second Beat periods plus worker/broker delay.
NOTIFICATION_RECOVERY_HEARTBEAT_MAX_AGE_SECONDS=180
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
# Receiving subdomain with MX configured in Resend, for example inbox.example.com.
RESEND_INBOUND_DOMAIN=

EVOLUTION_ENABLED=false
EVOLUTION_API_KEY=
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=

# Backup encryption/offsite copy. Use absolute paths; the passphrase and SSH key stay outside Git.
BACKUP_DIRECTORY=/var/backups/legaltech
BACKUP_PASSPHRASE_FILE=/etc/legaltech/backup-passphrase
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=26
BACKUP_OFFSITE_SSH_DESTINATION=
BACKUP_OFFSITE_SSH_KEY_PATH=/etc/legaltech/backup-offsite-ed25519
